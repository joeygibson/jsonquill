#!/usr/bin/env bash
# Update GitHub release notes from a release-notes file
# Usage: update-release <version>
# Example: update-release 0.14.0

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

if [ $# -eq 0 ]; then
    echo -e "${RED}Error: Missing version argument${NC}" >&2
    echo "Usage:"
    echo "  update-release <version>"
    echo ""
    echo "Examples:"
    echo "  update-release 0.14.0    # Updates release v0.14.0 from release-notes-v0.14.0.md"
    exit 1
fi

version=$1

# Strip leading 'v' if provided
version="${version#v}"

tag="v$version"
notes_file="release-notes-v$version.md"

# Check that the release notes file exists
if [ ! -f "$notes_file" ]; then
    echo -e "${RED}Error: Release notes file not found: $notes_file${NC}" >&2
    exit 1
fi

# Check that gh CLI is available
if ! command -v gh &> /dev/null; then
    echo -e "${RED}Error: gh CLI is not installed. Install it from https://cli.github.com/${NC}" >&2
    exit 1
fi

# Check that the release exists
if ! gh release view "$tag" &> /dev/null; then
    echo -e "${RED}Error: Release $tag not found on GitHub${NC}" >&2
    echo -e "${YELLOW}Available releases:${NC}" >&2
    gh release list --limit 10
    exit 1
fi

echo -e "${GREEN}Updating release $tag with notes from $notes_file${NC}"

gh release edit "$tag" --notes-file "$notes_file"

echo -e "${GREEN}Release $tag updated successfully!${NC}"
echo -e "${YELLOW}View at: https://github.com/joeygibson/jsonquill/releases/tag/$tag${NC}"
